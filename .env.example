# Copy to .env next to docker-compose.yml. No secrets here: those are files in secrets/.

# The published image and the release to run.
ASO_HUB_IMAGE=liftbridgelabs/aso-hub
ASO_HUB_VERSION=1.1.0

# App Store Connect (a key with the Sales role; the .p8 file goes in secrets/asc-key.p8).
ASC_ISSUER_ID=
ASC_KEY_ID=
ASC_VENDOR_NUMBER=

# Google Play reports bucket (the service account key goes in secrets/google-play.json).
PLAY_BUCKET=

# Your AsoBeast: the API the hub reads, and the web address used for links.
ASOBEAST_URL=
ASOBEAST_WEB_URL=

# The address you open the hub at. It is used for links in Discord posts, and the hub
# refuses addresses it doesn't know. More names can go in ASO_HUB_ALLOWED_HOSTS (comma separated).
ASO_HUB_URL=http://127.0.0.1:8690
